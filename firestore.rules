rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for profile data, write restricted to authenticated admin
    match /profile/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public read for published projects, full access for authenticated admin
    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact inquiries: allow public create so recruiters can submit inquiries
    // Read, update, and delete are strictly reserved for authenticated admin
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
